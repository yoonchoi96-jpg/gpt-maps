# Copy this file to .dev.vars for local development only.
# NEVER commit .dev.vars or real secret values.
APP_ORIGIN=https://gpt-maps-private.YOUR_SUBDOMAIN.workers.dev
NAVER_LOGIN_CLIENT_ID=SET_IN_CLOUDFLARE_SECRETS
NAVER_LOGIN_CLIENT_SECRET=SET_IN_CLOUDFLARE_SECRETS
SESSION_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
# First verified NAVER OAuth login displays an app-scoped profile id.
# Set only after independently verifying this is your own account.
ALLOWED_NAVER_USER_ID=YOUR_NAVER_PROFILE_RESPONSE_ID
